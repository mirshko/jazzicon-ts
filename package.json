{
  "name": "jazzicon-ts",
  "version": "5.0.1",
  "description": "Typescript version of Jazzicon",
  "keywords": [],
  "homepage": "https://github.com/mirshko/jazzicon-ts#readme",
  "bugs": {
    "url": "https://github.com/mirshko/jazzicon-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirshko/jazzicon-ts.git"
  },
  "license": "MIT",
  "author": "Jeff Reiner",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "source": "src/index.ts",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint",
    "release": "pnpm run build && pnpm changeset publish",
    "typecheck": "tsc"
  },
  "dependencies": {
    "colord": "^2.9.3",
    "mersenne-twister": "^1.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/cli": "^2.31.0",
    "@types/mersenne-twister": "^1.1.7",
    "oxlint": "^1.74.0",
    "publint": "^0.3.21",
    "tsdown": "^0.22.7",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.33.2",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
