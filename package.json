{
  "name": "jazzicon-ts",
  "publishConfig": {
    "access": "public"
  },
  "author": "Jeff Reiner",
  "description": "Typescript version of Jazzicon",
  "version": "4.0.0",
  "license": "MIT",
  "source": "src/index.ts",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup ./src/index.ts --format cjs,esm --dts",
    "release": "pnpm run build && pnpm changeset publish",
    "lint": "oxlint",
    "typecheck": "tsc"
  },
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/mersenne-twister": "^1.1.7",
    "colord": "^2.9.3",
    "mersenne-twister": "^1.1.0",
    "oxlint": "^1.74.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirshko/jazzicon-ts.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/mirshko/jazzicon-ts/issues"
  },
  "homepage": "https://github.com/mirshko/jazzicon-ts#readme"
}
